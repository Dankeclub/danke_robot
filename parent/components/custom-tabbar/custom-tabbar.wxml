<view class="tb" style="padding-bottom:{{sb}}px">
  <view class="tbi">
    <view class="ti {{s===0?'on':''}}" data-i="0" bind:tap="go">
      <image class="ti-ic" src="/icons/tab-home{{s===0?'-on':''}}.svg" mode="aspectFit"/>
      <text class="ti-lb">首页</text>
    </view>
    <view class="tcw">
      <view class="tc" data-i="1" bind:tap="go">
        <image class="tc-ic" src="/icons/tab-monitor.svg" mode="aspectFit"/>
      </view>
      <text class="tcl">看护</text>
    </view>
    <view class="ti {{s===2?'on':''}}" data-i="2" bind:tap="go">
      <image class="ti-ic" src="/icons/tab-mine{{s===2?'-on':''}}.svg" mode="aspectFit"/>
      <text class="ti-lb">我的</text>
    </view>
  </view>
</view>
