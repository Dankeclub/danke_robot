/* 蛋仔家长端 · 全局设计令牌（页面级有效，组件用硬编码） */
page {
  --pl: #c1d6f1;
  --pd: #778ccd;
  --pg: #dff6e6;
  --pp: #fed4d8;
  --pa1: #B6C2CF;
  --pa2: #97979C;
  --pa3: #DBDDDA;
  --bg: #f8f6f2;
  --white: #fff;
  --warm: #F7E6D4;
  --amber: #F0A855;
  --r: 56rpx;
  --m: 44rpx;
  --g: 28rpx;
  --t1: 48rpx;
  --t2: 38rpx;
  --t3: 34rpx;
  --t4: 30rpx;
  --t5: 28rpx;
  --t6: 24rpx;
  box-sizing: border-box;
  background: #f8f6f2;
  color: #3D3D50;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 34rpx;
  line-height: 1.5;
}

/* 全局 illo 卡片 */
.illo-card {
  margin: 0 var(--m) var(--g);
  background: var(--white);
  border-radius: var(--r);
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.illo-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--warm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.illo-body { flex: 1; }
.illo-title {
  font-size: var(--t3);
  font-weight: 800;
  color: #3D3D50;
}
.illo-sub {
  font-size: var(--t5);
  font-weight: 500;
  color: var(--pa2);
  margin-top: 6rpx;
}

/* 卡片入场 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.ca { animation: fadeUp 0.35s ease-out backwards; }
.ca:nth-child(1) { animation-delay: 0.02s; }
.ca:nth-child(2) { animation-delay: 0.05s; }
.ca:nth-child(3) { animation-delay: 0.08s; }
.ca:nth-child(4) { animation-delay: 0.11s; }
.ca:nth-child(5) { animation-delay: 0.14s; }
.ca:nth-child(6) { animation-delay: 0.17s; }
.ca:nth-child(7) { animation-delay: 0.20s; }
.ca:nth-child(8) { animation-delay: 0.23s; }
.ca:nth-child(9) { animation-delay: 0.26s; }
