<!-- 首页 -->
<view class="pw">
  <!-- Hero -->
  <view class="hz ca">
    <view class="hmr">
      <view class="hm"><danke-mascot size="md" state="{{dankeState}}"/></view>
      <view class="hg"><view class="hgt">下午好，{{childName}}妈妈</view>
        <view class="hs"><view class="hd {{dankeState}}"/><text>{{statusText}}</text></view>
      </view>
    </view>
    <view class="hsw">
      <view wx:for="{{states}}" wx:key="*this" class="hsb {{dankeState===item?item:''}}" data-state="{{item}}" bind:tap="onSwitchState"/>
    </view>
  </view>

  <!-- 在线内容 -->
  <block wx:if="{{dankeState !== 'offline'}}">
  <!-- Chips -->
  <view class="hcs ca">
    <view class="hc c1" bind:tap="goUsage"><image class="hci" src="/icons/ic-clock-pd.svg" mode="aspectFit"/><text class="hcl">使用时长</text></view>
    <view class="hc c2" bind:tap="goBehavior"><image class="hci" src="/icons/ic-check-rose.svg" mode="aspectFit"/><text class="hcl">行为分析</text></view>
    <view class="hc c3" bind:tap="goLearning"><image class="hci" src="/icons/ic-clip-mint.svg" mode="aspectFit"/><text class="hcl">学习追踪</text></view>
    <view class="hc c4" bind:tap="openTask"><image class="hci" src="/icons/ic-edit-amber.svg" mode="aspectFit"/><text class="hcl">派任务</text></view>
  </view>

  <!-- 今日概览 -->
  <view class="hlc ca">
    <view class="hhd"><view class="hht">{{taskSectionTitle}}</view></view>
    <scroll-view wx:if="{{todayItems.length > 0}}" class="hl-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{todayItems}}" wx:key="text" class="hlr">
        <view class="hck {{item.done?'on':''}}"><text wx:if="{{item.done}}">✓</text><view wx:else class="hde"/></view>
        <view class="hrt" style="{{item.done?'':'opacity:.65'}}">{{item.text}}<text class="hsu">{{item.sub}}</text></view>
      </view>
    </scroll-view>
    <view wx:if="{{todayItems.length > 3}}" class="hl-more">下滑查看更多</view>
    <view wx:if="{{todayItems.length === 0}}" class="hl-empty">暂无任务，从"派任务"给蛋仔发送任务吧</view>
  </view>

  <!-- 统计 -->
  <view class="hsr ca">
    <view class="hsc rose"><view class="hslb">今日使用时长</view><view class="hsn">86<text class="hsnu">m</text></view><view class="hssb">目标达成 72%</view><view class="hspk r"><view wx:for="{{[12,18,9,22,16,20,24]}}" wx:key="*this" class="hb" style="height:{{item}}rpx"/></view></view>
    <view class="hsc mint"><view class="hslb">专注度评分</view><view class="hsn">92<text class="hsnu">%</text></view><view class="hssb">↑ 3% vs 昨日</view><view class="hspk m"><view wx:for="{{[16,20,18,23,19,24,22]}}" wx:key="*this" class="hb" style="height:{{item}}rpx"/></view></view>
  </view>

  <!-- AI卡 -->
  <view class="hai ca"><view class="haic"><image class="haii" src="/icons/ic-edit-white.svg" mode="aspectFit"/></view><view class="hait"><view class="haiti">蛋仔说…</view><text class="haib">小宇连续答对 12 道心算题，数学正确率较昨日提升 8%。继续保持哦！</text></view></view>

  <!-- 时间线 -->
  <view class="htc ca">
    <view class="hth"><view class="htht"><image class="hti" src="/icons/ic-clock-pa2.svg" mode="aspectFit"/><text class="httx">最近行为</text></view><text class="htm" bind:tap="goReport">查看全部 →</text></view>
    <view wx:for="{{timelineItems}}" wx:key="text" class="htli"><view class="htld {{item.color}}"/><view class="htlb"><view class="htlt">{{item.time}}</view><view class="htlds">{{item.text}}<text wx:if="{{item.tag}}" class="htg {{item.tagColor}}">{{item.tag}}</text></view></view></view>
  </view>

  </block>

  <!-- 离线态 -->
  <view wx:else class="hof">
    <view class="hom"><danke-mascot size="lg" state="offline"/></view>
    <view class="hot">蛋仔正在休息</view><view class="hod">设备离线，无法实时看护</view>
    <view class="hob" bind:tap="goDevice">✓ 去连接</view>
  </view>

  <custom-tabbar/>

  <!-- ===== 派任务底部弹出面板 ===== -->
  <view class="task-sheet-mask {{showTaskSheet ? 'show' : ''}}" bind:tap="closeTaskSheet"></view>
  <view class="task-sheet {{showTaskSheet ? 'show' : ''}}" style="padding-bottom:{{safeBottom + 60}}rpx">
    <view class="ts-handle" catch:tap="noop">
      <view class="ts-handle-bar"></view>
    </view>
    <view class="ts-title">派任务给蛋仔</view>

    <view class="ts-tabs-row">
      <scroll-view class="ts-tabs" scroll-x>
        <view wx:for="{{taskTabs}}" wx:key="*this" class="ts-tab {{activeTaskTab === index ? 'active' : ''}}" bind:tap="onTaskTabTap" data-index="{{index}}">{{item}}</view>
      </scroll-view>
      <view class="ts-select-all" bind:tap="onSelectAll">
        <text>{{selectAll ? '取消' : '全选'}}</text>
      </view>
    </view>

    <view class="ts-list">
      <view wx:for="{{displayTasks}}" wx:key="_key" class="ts-item {{selectedMap[index] ? 'selected' : ''}}" bind:tap="onTaskSelect" data-index="{{index}}">
        <view class="ts-item-left">
          <image class="ts-item-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"/>
          <text class="ts-item-name">{{item.name}}</text>
          <text wx:if="{{item.isCustom}}" class="ts-custom-tag">自定义</text>
        </view>
        <view class="ts-item-right">
          <view wx:if="{{item.isCustom}}" class="ts-item-del" catch:tap="onDeleteCustomTask" data-index="{{index}}">
            <image class="ts-del-icon" src="/icons/x.svg" mode="aspectFit"/>
          </view>
          <view class="ts-item-check {{selectedMap[index] ? 'on' : ''}}">
            <image wx:if="{{selectedMap[index]}}" class="ts-check-icon" src="/icons/ic-check-white.svg" mode="aspectFit"/>
          </view>
        </view>
      </view>
      <view wx:if="{{displayTasks.length === 0}}" class="ts-empty">暂无任务，添加一个自定义任务吧</view>
    </view>

    <view class="ts-custom-row">
      <input class="ts-custom-input" value="{{customInput}}" placeholder="输入自定义任务…" bind:input="onCustomInput" confirm-type="done" bind:confirm="onAddCustomTask" maxlength="30" />
      <view class="ts-custom-add" bind:tap="onAddCustomTask">添加</view>
    </view>

    <view class="ts-send-btn {{selectedTasks.length > 0 ? 'ready' : ''}}" bind:tap="onSendTask">
      <image class="ts-send-icon" src="/icons/ic-send-white.svg" mode="aspectFit"/>
      <text>发送任务{{selectedTasks.length > 0 ? '（' + selectedTasks.length + '）' : ''}}</text>
    </view>
  </view>
</view>
