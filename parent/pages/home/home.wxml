<!-- 首页 -->
<view class="pw">
  <!-- Hero -->
  <view class="hz ca">
    <view class="hmr">
      <view class="hm"><danke-mascot size="md" state="{{dankeState}}"/></view>
      <view class="hg"><view class="hgt">下午好，{{childName}}妈妈</view>
        <view class="hs"><view class="hd {{dankeState}}"/><text>{{statusText}}</text></view>
      </view>
    </view>
    <view class="hsw">
      <view wx:for="{{states}}" wx:key="*this" class="hsb {{dankeState===item?item:''}}" data-state="{{item}}" bind:tap="onSwitchState"/>
    </view>
  </view>

  <!-- Chips -->
  <view class="hcs ca">
    <view class="hc c1" bind:tap="goUsage"><image class="hci" src="/icons/ic-clock-pd.svg" mode="aspectFit"/><text class="hcl">使用时长</text></view>
    <view class="hc c2" bind:tap="goBehavior"><image class="hci" src="/icons/ic-check-rose.svg" mode="aspectFit"/><text class="hcl">行为分析</text></view>
    <view class="hc c3" bind:tap="goLearning"><image class="hci" src="/icons/ic-clip-mint.svg" mode="aspectFit"/><text class="hcl">学习追踪</text></view>
    <view class="hc c4" bind:tap="openTask"><image class="hci" src="/icons/ic-edit-amber.svg" mode="aspectFit"/><text class="hcl">派任务</text></view>
  </view>

  <!-- 今日概览 -->
  <view class="hlc ca">
    <view class="hhd"><view class="hht">今日概览</view><text class="hda">6 月 22 日 · 周一</text></view>
    <view wx:for="{{todayItems}}" wx:key="text" class="hlr">
      <view class="hck {{item.done?'on':''}}"><text wx:if="{{item.done}}">✓</text><view wx:else class="hde"/></view>
      <view class="hrt" style="{{item.done?'':'opacity:.65'}}">{{item.text}}<text class="hsu">{{item.sub}}</text></view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="hsr ca">
    <view class="hsc rose"><view class="hslb">今日使用时长</view><view class="hsn">86<text class="hsnu">m</text></view><view class="hssb">目标达成 72%</view><view class="hspk r"><view wx:for="{{[12,18,9,22,16,20,24]}}" wx:key="*this" class="hb" style="height:{{item}}rpx"/></view></view>
    <view class="hsc mint"><view class="hslb">专注度评分</view><view class="hsn">92<text class="hsnu">%</text></view><view class="hssb">↑ 3% vs 昨日</view><view class="hspk m"><view wx:for="{{[16,20,18,23,19,24,22]}}" wx:key="*this" class="hb" style="height:{{item}}rpx"/></view></view>
  </view>

  <!-- AI卡 -->
  <view class="hai ca"><view class="haic"><image class="haii" src="/icons/ic-edit-white.svg" mode="aspectFit"/></view><view class="hait"><view class="haiti">蛋仔说…</view><text class="haib">小宇连续答对 12 道心算题，数学正确率较昨日提升 8%。继续保持哦！</text></view></view>

  <!-- 时间线 -->
  <view class="htc ca">
    <view class="hth"><view class="htht"><image class="hti" src="/icons/ic-clock-pa2.svg" mode="aspectFit"/><text class="httx">最近行为</text></view><text class="htm" bind:tap="goReport">查看全部 →</text></view>
    <view wx:for="{{timelineItems}}" wx:key="text" class="htli"><view class="htld {{item.color}}"/><view class="htlb"><view class="htlt">{{item.time}}</view><view class="htlds">{{item.text}}<text wx:if="{{item.tag}}" class="htg {{item.tagColor}}">{{item.tag}}</text></view></view></view>
  </view>

  <!-- 学习进度 -->
  <view class="hps ca">
    <view class="hpt"><image class="hti" src="/icons/ic-chart-pd.svg" mode="aspectFit"/><text class="hptx">学习进度</text></view>
    <view class="hpc">
      <view class="hph"><text class="hphl">今日目标</text><text class="hphr">86 / 120 min · 72%</text></view>
      <view class="hpb"><view class="hpf" style="width:72%"/></view>
      <view class="hmb">
        <view wx:for="{{miniProgress}}" wx:key="label" class="hmr2"><view class="hmd {{item.color}}"/><text class="hml">{{item.label}}</text><view class="hmt"><view class="hmf" style="width:{{item.percent}}%;background:{{item.barColor}}"/></view></view>
      </view>
    </view>
  </view>

  <!-- 学习快报 -->
  <view class="hls ca"><view class="hli"><image class="hlii" src="/icons/ic-star-white.svg" mode="aspectFit"/></view><view class="hlc2"><view class="hlct">学习快报</view><view class="hln">3<text class="hlu"> 个</text></view><view class="hlds">今日新掌握知识点</view></view></view>

  <!-- 蛋仔插画卡 -->
  <view class="hic ca"><view class="hif"><danke-mascot size="sm" state="online"/></view><view class="hicc"><view class="hit">蛋仔陪你一起成长</view><view class="hid">数学心算模块表现优秀 · 继续保持！</view></view></view>

  <!-- 离线态 -->
  <view wx:if="{{dankeState==='offline'}}" class="hof">
    <view class="hom"><danke-mascot size="lg" state="offline"/></view>
    <view class="hot">蛋仔正在休息</view><view class="hod">设备离线，无法实时看护</view>
    <view class="hob" bind:tap="goDevice">✓ 去连接</view>
  </view>

  <custom-tabbar/>
</view>
