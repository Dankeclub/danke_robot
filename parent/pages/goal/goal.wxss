/* ===== 学习目标设置页 ===== */

/* 目标时长卡片 */
.goal-goal-card {
  margin: 32rpx var(--m) 28rpx;
  background: var(--pd);
  border-radius: var(--r);
  padding: 52rpx 44rpx 44rpx;
  color: var(--white);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.goal-goal-card::after {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  bottom: -40rpx;
  right: -20rpx;
  background: rgba(255,255,255,0.05);
}
.goal-ghdr {
  font-size: var(--t2);
  font-weight: 800;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.goal-ghdr-icon {
  width: 36rpx;
  height: 36rpx;
}
.goal-goal-big {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}
.goal-gnum   { font-size: 120rpx; font-weight: 900; line-height: 1; }
.goal-gunit  { font-size: 52rpx; font-weight: 700; margin-left: 6rpx; }
.goal-glabel {
  font-size: var(--t4);
  opacity: 0.6;
  margin-top: 12rpx;
  font-weight: 500;
}

/* 滑块 */
.goal-slider-wrap {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  padding: 0 4rpx;
}
.goal-slider-track {
  height: 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 6rpx;
  position: relative;
}
.goal-slider-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--white);
  transition: width 0.05s linear;
}
.goal-slider-thumb {
  position: absolute;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--white);
  transform: translate(-50%, -50%);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 2;
}
.goal-slider-marks {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}
.goal-slider-marks text {
  font-size: var(--t5);
  font-weight: 600;
  opacity: 0.55;
}

/* 模块分配标题 */
.goal-mod-section-label {
  font-size: var(--t2);
  font-weight: 800;
  color: var(--pd);
  margin: 40rpx var(--m) 20rpx;
}

/* 模块列表 */
.goal-mod-section {
  margin: 0 var(--m);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.goal-mod-item {
  border-radius: 44rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.goal-mod-item.math  { background: rgba(119,140,205,0.1); }
.goal-mod-item.sci   { background: rgba(109,175,125,0.1); }
.goal-mod-item.eng   { background: rgba(216,122,130,0.1); }
.goal-mod-item.poem  { background: rgba(151,151,156,0.1); }
.goal-mod-item.music { background: rgba(240,168,85,0.1); }

.goal-mod-left-bar {
  width: 8rpx;
  height: 64rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.goal-mod-item.math  .goal-mod-left-bar { background: var(--pd); }
.goal-mod-item.sci   .goal-mod-left-bar { background: #4F9A5F; }
.goal-mod-item.eng   .goal-mod-left-bar { background: #D97A84; }
.goal-mod-item.poem  .goal-mod-left-bar { background: var(--pa2); }
.goal-mod-item.music .goal-mod-left-bar { background: #D4892E; }

.goal-mod-body { flex: 1; min-width: 0; }
.goal-mod-name {
  font-size: var(--t3);
  font-weight: 800;
  color: #3D3D50;
}
.goal-mod-hint {
  font-size: var(--t5);
  font-weight: 500;
  color: var(--pa2);
  margin-top: 4rpx;
}

/* 模块时间显示 */
.goal-mod-time {
  font-size: var(--t1);
  font-weight: 900;
  flex-shrink: 0;
  line-height: 1;
}
.goal-mod-item.math  .goal-mod-time { color: var(--pd); }
.goal-mod-item.sci   .goal-mod-time { color: #4F9A5F; }
.goal-mod-item.eng   .goal-mod-time { color: #D97A84; }
.goal-mod-item.poem  .goal-mod-time { color: var(--pa2); }
.goal-mod-item.music .goal-mod-time { color: #D4892E; }
.goal-munit {
  font-size: var(--t4);
  font-weight: 600;
  margin-left: 4rpx;
}

/* 步进按钮 */
.goal-mod-stepper {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 0 16rpx;
}
.goal-stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.goal-stepper-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 保存按钮 */
.goal-save-btn {
  margin: 44rpx var(--m) 60rpx;
  display: block;
  width: calc(100% - 88rpx);
  padding: 34rpx;
  background: var(--pd);
  color: var(--white);
  border-radius: 36rpx;
  font-size: var(--t2);
  font-weight: 800;
  box-shadow: 0 8rpx 32rpx rgba(119,140,205,0.25);
  border: none;
}
.goal-save-btn::after { border: none; }
