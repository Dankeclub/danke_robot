/* ===== 登录页 ===== */

.login-body {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 56rpx;
  background: linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
}

.login-mascot-circle {
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 56rpx;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.03);
}

.login-app-name {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--pd);
  letter-spacing: -0.6rpx;
}

.login-app-tag {
  font-size: var(--t3);
  color: var(--pa2);
  font-weight: 600;
  margin-top: 12rpx;
  margin-bottom: 64rpx;
}

.login-wx-btn {
  width: 100%;
  padding: 32rpx;
  background: #07C160;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: var(--t2);
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.22);
  border: none;
}
.login-wx-btn::after {
  border: none;
}

.login-privacy {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  justify-content: center;
  margin-top: 36rpx;
}

.login-pcheck {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid var(--pa1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.login-pcheck.checked {
  background: var(--pd);
  border-color: var(--pd);
}

.login-check-icon {
  color: var(--white);
  font-size: 24rpx;
  font-weight: 700;
}

.login-ptext {
  font-size: var(--t4);
  font-weight: 500;
  color: var(--pa2);
  line-height: 1.5;
}
