/* ===== 报告中心 ===== */

/* 导航 */
.rc-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 48rpx var(--m) 20rpx;
}
.rc-nav-title {
  font-size: var(--t2);
  font-weight: 800;
  color: #3D3D50;
}
.rc-nav-badge {
  position: absolute;
  right: var(--m);
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--t6);
  font-weight: 700;
  background: var(--pp);
  color: #8B5A5E;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

.rc-subhead {
  text-align: center;
  font-size: var(--t5);
  font-weight: 500;
  color: var(--pa2);
  margin-bottom: 20rpx;
}

/* 周选择行 */
.rc-week-strip {
  width: 100%;
  margin-bottom: var(--g);
  box-sizing: border-box;
  white-space: nowrap;
}
.rc-week-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 6rpx var(--m);
}
.rc-week-inner::after {
  content: '';
  display: inline-block;
  width: calc(var(--m) - 16rpx);
  flex-shrink: 0;
}
.rc-ws-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 32rpx;
  border-radius: 32rpx;
  background: var(--white);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02);
  flex-shrink: 0;
  position: relative;
}
.rc-ws-pill.rc-ws-active {
  background: var(--pd);
  box-shadow: 0 6rpx 24rpx rgba(119,140,205,0.22);
}
.rc-ws-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: var(--white);
  background: #E8826B;
  padding: 2rpx 10rpx;
  border-radius: 14rpx;
  letter-spacing: 0.5rpx;
}
.rc-ws-label {
  font-size: var(--t4);
  font-weight: 700;
  color: #3D3D50;
}
.rc-ws-pill.rc-ws-active .rc-ws-label {
  color: var(--white);
}

/* Hero 推荐卡片 */
.rc-hero {
  margin: 0 var(--m) var(--g);
}
.rc-hero-eyebrow {
  font-size: var(--t6);
  font-weight: 700;
  color: var(--pd);
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.rc-hero-eyebrow-icon {
  width: 24rpx;
  height: 24rpx;
}
.rc-hero-card {
  background: linear-gradient(135deg, #778ccd, #8b9dd8);
  border-radius: 48rpx;
  padding: 48rpx 40rpx;
  color: var(--white);
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 56rpx rgba(119,140,205,0.22);
}
.rc-hero-card:active {
  transform: scale(0.97);
}
.rc-hero-card::after {
  content: '';
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  top: -80rpx;
  right: -48rpx;
  background: rgba(255,255,255,0.05);
}
.rc-h-week {
  font-size: var(--t6);
  opacity: 0.6;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  font-weight: 500;
}
.rc-h-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
  letter-spacing: -1rpx;
}
.rc-h-insights {
  display: flex;
  gap: 36rpx;
  position: relative;
  z-index: 1;
}
.rc-h-insight-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--t5);
  font-weight: 600;
}
.rc-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.rc-dot-warn  { background: rgba(254,212,216,0.85); }
.rc-dot-trend { background: rgba(248,255,199,0.85); }
.rc-dot-link  { background: rgba(223,246,230,0.85); }
.rc-hero-arrow {
  position: absolute;
  right: 36rpx;
  bottom: 36rpx;
  font-size: 48rpx;
  font-weight: 700;
  opacity: 0.4;
  z-index: 1;
}

/* 快速入口 */
.rc-quick-row {
  display: flex;
  gap: 18rpx;
  margin: 0 var(--m) var(--g);
}
.rc-quick-card {
  flex: 1;
  background: var(--white);
  border-radius: 40rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}
.rc-quick-card:active {
  transform: scale(0.97);
}
.rc-q-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}
.rc-q-mining  { background: rgba(119,140,205,0.1); }
.rc-q-behavior { background: rgba(110,191,139,0.12); }
.rc-q-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.rc-q-title {
  font-size: var(--t3);
  font-weight: 700;
  color: #3D3D50;
}
.rc-q-sub {
  font-size: var(--t6);
  font-weight: 500;
  color: var(--pa2);
  margin-top: 4rpx;
}

/* 分区标题 */
.rc-sec {
  margin: 0 var(--m) 18rpx;
  font-size: var(--t3);
  font-weight: 800;
  color: var(--pd);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rc-sec-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 历史报告列表 */
.rc-hist {
  margin: 0 var(--m) var(--g);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.rc-hist-item {
  background: var(--white);
  border-radius: 36rpx;
  padding: 32rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.rc-hist-item:active {
  transform: scale(0.98);
}
.rc-hist-faded {
  opacity: 0.35;
}
.rc-hi-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rc-hi-mining  { background: rgba(119,140,205,0.08); }
.rc-hi-weekly  { background: rgba(110,191,139,0.08); }
.rc-hi-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.rc-hi-info { flex: 1; min-width: 0; }
.rc-hi-week {
  font-size: var(--t3);
  font-weight: 800;
  color: #3D3D50;
}
.rc-hi-sub {
  font-size: var(--t6);
  color: var(--pa2);
  font-weight: 500;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rc-hi-tag {
  display: inline-block;
  font-size: var(--t6);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 700;
}
.rc-hi-tag.warn  { background: rgba(240,168,85,0.1);  color: #B45309; }
.rc-hi-tag.good  { background: rgba(110,231,183,0.12); color: #047857; }
.rc-hi-tag.learn { background: rgba(119,140,205,0.08); color: var(--pd); }
.rc-hi-arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
