/* ===== 通知列表页 ===== */

.notif-filter-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx var(--m) 28rpx;
}
.notif-filter-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 32rpx;
  font-size: var(--t5);
  font-weight: 700;
  background: var(--white);
  color: var(--pa2);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}
.notif-filter-chip.on {
  background: var(--pd);
  color: var(--white);
}

.notif-date-label {
  font-size: var(--t5);
  font-weight: 700;
  color: var(--pa2);
  margin: 0 var(--m) 12rpx;
}

.notif-list {
  margin: 0 var(--m) var(--g);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notif-item {
  background: var(--white);
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  position: relative;
}
.notif-item.unread::after {
  content: '';
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--pd);
}

.notif-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 36rpx;
}
.notif-icon.amber { background: rgba(240,168,85,0.12); }
.notif-icon.mint  { background: rgba(110,191,139,0.15); }
.notif-icon.sky   { background: rgba(119,140,205,0.12); }

.notif-body { flex: 1; }
.notif-ntitle { font-size: var(--t3); font-weight: 700; color: #3D3D50; margin-bottom: 4rpx; }
.notif-ndesc  { font-size: var(--t5); font-weight: 500; color: #7A7A82; line-height: 1.4; }
.notif-ntime  { font-size: var(--t5); font-weight: 600; color: var(--pa2); margin-top: 8rpx; }

.notif-dot {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--pd);
}

/* 空状态 */
.notif-empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.notif-e-icon {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 28rpx;
  background: var(--pa3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}
.notif-e-title { font-size: var(--t2); font-weight: 800; color: var(--pa2); margin-bottom: 12rpx; }
.notif-e-desc  { font-size: var(--t4); color: var(--pa1); }
