/* ===== 行为分析页 ===== */

/* Tab 栏 */
.bh-tab-bar {
  display: flex;
  margin: 8rpx var(--m) 20rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.bh-tab-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 24rpx;
  font-size: var(--t3);
  font-weight: 700;
  color: var(--pa2);
}
.bh-tab-btn.on {
  background: #8a9cc8;
  color: var(--white);
  box-shadow: 0 4rpx 18rpx rgba(138,156,200,0.25);
}

/* Tab 内容 */
.bh-tab-content {
  /* container for fade-up children */
}

/* 评分卡片 - 渐变背景 */
.bh-score-card {
  margin: 0 var(--m) var(--g);
  border-radius: 48rpx;
  padding: 48rpx 40rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.bh-score-card::after {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  top: -60rpx;
  right: -36rpx;
  background: rgba(255,255,255,0.1);
}
.bh-score-card.focus-bg    { background: linear-gradient(135deg, #a8b8e0, #c2cff0); }
.bh-score-card.posture-bg  { background: linear-gradient(135deg, #f0bbc2, #e9a8b0); }
.bh-score-card.location-bg { background: linear-gradient(135deg, #8dc89a, #74b985); }

.bh-sc-left { position: relative; z-index: 1; }
.bh-sc-label {
  font-size: var(--t5);
  font-weight: 700;
  letter-spacing: 1rpx;
  color: rgba(0,0,0,0.35);
}
.bh-sc-value {
  font-size: 128rpx;
  font-weight: 900;
  color: #3D3D50;
  line-height: 1;
  margin-top: 8rpx;
}
.bh-sc-change {
  font-size: var(--t5);
  font-weight: 700;
  color: rgba(0,0,0,0.4);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.bh-sc-right { position: relative; z-index: 1; text-align: right; }
.bh-sc-unit-label {
  font-size: var(--t6);
  font-weight: 600;
  color: rgba(0,0,0,0.3);
  margin-bottom: 2rpx;
}
.bh-sc-big-unit {
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.35);
}

/* 统计网格 */
.bh-stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 var(--m) var(--g);
}
.bh-stat-item {
  width: calc(50% - 8rpx);
  margin: 4rpx;
  background: var(--white);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  box-sizing: border-box;
}
.bh-stat-item.bh-stat-bar {
  padding-bottom: 24rpx;
}
.bh-sv {
  font-size: 48rpx;
  font-weight: 900;
  color: #3D3D50;
  line-height: 1;
}
.bh-sv-green {
  font-size: var(--t3);
  font-weight: 800;
  color: #4F9A5F;
}
.bh-su {
  font-size: var(--t4);
  font-weight: 600;
  color: var(--pa2);
}
.bh-sl {
  font-size: var(--t5);
  font-weight: 600;
  color: var(--pa2);
  margin-top: 10rpx;
}
.bh-bar-wrap {
  height: 8rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 4rpx;
  margin-top: 18rpx;
  overflow: hidden;
}
.bh-bar-fill { height: 100%; border-radius: 4rpx; }
.bh-bar-f { background: #a8b8e0; }
.bh-bar-l { background: #74b985; }

/* 分区标题 */
.bh-sec {
  margin: 0 var(--m) 16rpx;
  font-size: var(--t5);
  font-weight: 700;
  color: #8a9cc8;
  display: flex;
  align-items: center;
  gap: 10rpx;
  letter-spacing: 0.5rpx;
}
.bh-sec-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 洞察卡片 */
.bh-insight {
  margin: 0 var(--m) 14rpx;
  background: var(--white);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.bh-mi-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bh-mi-icon.focus-icon    { background: rgba(168,184,224,0.14); }
.bh-mi-icon.posture-icon  { background: rgba(240,187,194,0.14); }
.bh-mi-icon.location-icon { background: rgba(141,200,154,0.14); }
.bh-mi-icon-img {
  width: 32rpx;
  height: 32rpx;
}
.bh-mi-body { flex: 1; min-width: 0; }
.bh-mi-title {
  font-size: var(--t4);
  font-weight: 800;
  color: #3D3D50;
  margin-bottom: 4rpx;
}
.bh-mi-desc {
  font-size: var(--t5);
  color: var(--pa2);
  font-weight: 500;
  line-height: 1.5;
}
.bh-mi-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}
.bh-mt {
  font-size: var(--t6);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 700;
}
.mt-f { background: rgba(168,184,224,0.14); color: #8a9cc8; }
.mt-p { background: rgba(240,187,194,0.14); color: #cc8e95; }
.mt-l { background: rgba(141,200,154,0.14);  color: #5d9e6e; }
.mt-t { background: rgba(240,168,85,0.1);  color: #B45309; }
