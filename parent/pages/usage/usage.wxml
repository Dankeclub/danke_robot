<!-- 使用时长详情页 -->
<view class="page-wrap">

  <!-- 时间维度切换 -->
  <view class="use-seg-row ca">
    <view
      wx:for="{{segments}}"
      wx:key="*this"
      class="use-seg {{activeSeg === item ? 'on' : ''}}"
      bind:tap="onSwitchSeg"
      data-seg="{{item}}"
    >{{item}}</view>
  </view>

  <!-- 统一卡片：摘要 + 图表 -->
  <view class="use-main-card ca">
    <!-- 摘要行：左大卡 + 右双卡 -->
    <view class="use-summary-row">
      <view class="use-smr use-smr-main">
        <view class="use-sv-main">86<text class="use-sv-unit">m</text></view>
        <view class="use-sl">今日使用</view>
        <view class="use-sm">目标 120m</view>
        <view class="use-mini-bar"><view class="use-mini-bar-fill" style="width:72%"></view></view>
      </view>
      <view class="use-smr-stack">
        <view class="use-smr use-smr-side">
          <view class="use-sv-side">34<text class="use-sv-unit">m</text></view>
          <view class="use-sl">剩余时长</view>
          <view class="use-sm">距今日限额</view>
        </view>
        <view class="use-smr use-smr-side">
          <view class="use-sv-side">92<text class="use-sv-unit">%</text></view>
          <view class="use-sl">日均达标</view>
          <view class="use-sm"><text class="use-trend up">↑3%</text> vs 上周</view>
        </view>
      </view>
    </view>

    <!-- 分隔线 -->
    <view class="use-divider"></view>

    <!-- 图表区 -->
    <view class="use-chart-section">
      <view class="use-chdr">{{chartTitle}}</view>
      <view class="use-bar-chart">
        <view wx:for="{{chartBars}}" wx:key="label" class="use-bar-col">
          <view class="use-bar-val">{{item.value}}m</view>
          <view class="use-bar-fill" style="height:{{item.height}}rpx; background:{{item.color}}"></view>
          <view class="use-bar-label">{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 模块分布 -->
  <view class="use-dist-card ca">
    <view class="use-dist-hd">模块分布</view>
    <view wx:for="{{modules}}" wx:key="key" class="use-dist-row">
      <view class="use-dist-icon {{item.key}}">{{item.icon}}</view>
      <view class="use-dist-info">
        <text class="use-dist-label">{{item.name}}</text>
        <view class="use-dist-bar-wrap">
          <view class="use-dist-bar {{item.key}}" style="width:{{item.percent}}%"></view>
        </view>
      </view>
      <text class="use-dist-val">{{item.time}}m</text>
    </view>
  </view>

</view>
