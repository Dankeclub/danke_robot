/* ===== 使用时长详情页 ===== */

/* 分段切换 */
.use-seg-row {
  display: flex;
  gap: 12rpx;
  margin: 28rpx var(--m) var(--g);
  background: var(--white);
  border-radius: 40rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.use-seg {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 32rpx;
  font-size: var(--t4);
  font-weight: 700;
  color: var(--pa2);
}
.use-seg.on {
  background: #8899D5;
  color: var(--white);
  box-shadow: 0 4rpx 20rpx rgba(119,140,205,0.2);
}

/* 统一卡片 */
.use-main-card {
  margin: 0 var(--m) var(--g);
  background: var(--white);
  border-radius: var(--r);
  padding: 40rpx 36rpx 36rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
}

/* 摘要行：左大卡 + 右双卡 */
.use-summary-row {
  display: flex;
  gap: 16rpx;
}
.use-smr-main {
  flex: 5;
  text-align: center;
  padding: 44rpx 32rpx 36rpx;
  border-radius: 36rpx;
  background: #FDEDDD;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.use-smr-stack {
  flex: 3;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.use-smr-side {
  flex: 1;
  text-align: center;
  padding: 28rpx 16rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.use-smr-side:nth-child(1) { background: #fed4d8; }
.use-smr-side:nth-child(2) { background: #dff6e6; }

.use-sv-main {
  font-size: 112rpx;
  font-weight: 900;
  line-height: 1;
  color: #8899D5;
}
.use-sv-side {
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}
.use-smr-side:nth-child(1) .use-sv-side { color: #D08C88; }
.use-smr-side:nth-child(2) .use-sv-side { color: #63A870; }
.use-sv-unit {
  font-size: var(--t3);
  font-weight: 700;
}
.use-sl {
  font-size: var(--t4);
  font-weight: 600;
  color: #5A5A62;
  margin-top: 12rpx;
}
.use-smr-side .use-sl { font-size: var(--t5); margin-top: 8rpx; }
.use-sm {
  font-size: var(--t5);
  font-weight: 500;
  color: var(--pa2);
  margin-top: 6rpx;
}
.use-smr-side .use-sm { font-size: var(--t6); }
.use-smr-side .use-sm { font-size: 22rpx; }

.use-mini-bar {
  height: 8rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.use-mini-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #8899D5;
}

/* 分隔线 */
.use-divider {
  height: 1rpx;
  background: #E8ECF2;
  margin: 32rpx 0 28rpx;
}

/* 图表区 */
.use-chart-section {
  padding: 0 4rpx;
}
.use-chdr {
  font-size: var(--t3);
  font-weight: 800;
  color: var(--pd);
  margin-bottom: 28rpx;
}

.use-bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
}
.use-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.use-bar-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #5A5A62;
}
.use-bar-fill {
  width: 52rpx;
  border-radius: 10rpx 10rpx 0 0;
  min-height: 6rpx;
}
.use-bar-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--pa2);
}

/* 模块分布 */
.use-dist-card {
  margin: 0 var(--m) var(--g);
  background: var(--white);
  border-radius: var(--r);
  padding: 40rpx 36rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
}
.use-dist-hd {
  font-size: var(--t3);
  font-weight: 800;
  color: var(--pd);
  margin-bottom: 24rpx;
}

.use-dist-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  margin-bottom: 8rpx;
}
.use-dist-row:last-child { margin-bottom: 0; }
.use-dist-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
}
.use-dist-icon.math { background: #8899D5; color: var(--white); }
.use-dist-icon.sci  { background: #63A870; color: var(--white); }
.use-dist-icon.eng  { background: #E08D96; color: var(--white); }
.use-dist-icon.poem { background: #A5A5A9; color: var(--white); }

.use-dist-info {
  flex: 1;
  min-width: 0;
}
.use-dist-label {
  font-size: var(--t4);
  font-weight: 700;
  color: #3D3D50;
  display: block;
  margin-bottom: 10rpx;
}
.use-dist-bar-wrap {
  height: 16rpx;
  background: rgba(0,0,0,0.04);
  border-radius: 8rpx;
  overflow: hidden;
}
.use-dist-bar {
  height: 100%;
  border-radius: 8rpx;
}
.use-dist-bar.math { background: #8899D5; }
.use-dist-bar.sci  { background: #63A870; }
.use-dist-bar.eng  { background: #E08D96; }
.use-dist-bar.poem { background: #A5A5A9; }

.use-dist-val {
  font-size: var(--t4);
  font-weight: 800;
  color: #5A5A62;
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}
