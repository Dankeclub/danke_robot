.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 32rpx 32rpx 0 32rpx;
  display: flex;
  flex-direction: column;
}

.info-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 8rpx 0;
  margin-bottom: 24rpx;
}

.info-row {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.row-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.row-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.row-value.highlight {
  color: var(--color-success);
}

.row-divider {
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background-color: var(--color-divider);
}
