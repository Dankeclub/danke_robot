<view class="page">
  <nav-bar title="设备信息" />

  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <!-- Info Card -->
    <view class="info-card">
      <view class="info-row" wx:for="{{deviceInfo}}" wx:key="label">
        <text class="row-label">{{item.label}}</text>
        <text class="row-value">{{item.value}}</text>
        <view class="row-divider" wx:if="{{index < deviceInfo.length - 1}}"></view>
      </view>
    </view>

    <!-- Status Card -->
    <view class="info-card">
      <view class="info-row" wx:for="{{deviceStatus}}" wx:key="label">
        <text class="row-label">{{item.label}}</text>
        <text class="row-value {{item.highlight ? 'highlight' : ''}}">{{item.value}}</text>
        <view class="row-divider" wx:if="{{index < deviceStatus.length - 1}}"></view>
      </view>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
