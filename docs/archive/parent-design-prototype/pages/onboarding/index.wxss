.page {
  min-height: 100vh;
  background: linear-gradient(0deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
  position: relative;
}

.onboard-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 64rpx;
  padding: 0 32rpx;
}

.danzai-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.4);
}

.danzai-img {
  width: 120rpx;
  height: 120rpx;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.welcome-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.welcome-sub {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  width: 100%;
  padding: 0 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  background-color: rgba(255,255,255,0.09);
  border-radius: var(--radius-lg);
  padding: 32rpx 40rpx;
}

.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background-color: rgba(255,255,255,0.13);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon {
  width: 44rpx;
  height: 44rpx;
}

.feature-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.feature-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.4;
}

.page-dots {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.27);
}

.dot.active {
  background-color: #FFFFFF;
}

.start-btn {
  width: 652rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: var(--radius-pill);
  background-color: #FFFFFF;
  margin: 0 auto;
  margin-bottom: 96rpx;
}

.start-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}
