.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 8rpx 32rpx 0 32rpx;
}

/* Hero Card */
.hero-card {
  background: linear-gradient(160deg, #1F2937 0%, #111827 100%);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(49,106,253,0.2);
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
}

.hero-label {
  font-size: 20rpx;
  color: var(--color-light-blue);
  letter-spacing: 4rpx;
}

.hero-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.online-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  background-color: rgba(172,232,40,0.13);
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--color-success);
}

.online-text {
  font-size: 22rpx;
  color: var(--color-success);
}

.hero-sn {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

.hero-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background-color: rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-icon {
  width: 56rpx;
  height: 56rpx;
}

.hero-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hero-sync {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.hero-detail {
  font-size: 24rpx;
  color: var(--color-light-blue);
}

/* Status Grid Card */
.status-grid-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  flex-direction: row;
  position: relative;
}

.status-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 32rpx;
}

.cell-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.cell-icon {
  width: 36rpx;
  height: 36rpx;
}

.cell-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.cell-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.cell-sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.cell-divider-h {
  height: 2rpx;
  background-color: var(--color-divider);
}

.cell-divider-v {
  width: 2rpx;
  background-color: var(--color-divider);
  margin: 24rpx 0;
}

/* Operations Card */
.ops-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 4rpx 0;
  margin-bottom: 24rpx;
}

.op-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.op-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.op-icon {
  width: 32rpx;
  height: 32rpx;
}

.op-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.op-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.op-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.op-arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.3;
}

.op-divider {
  height: 2rpx;
  background-color: var(--color-divider);
  margin: 0 32rpx;
}

/* Unbind Button */
.unbind-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-card);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

.unbind-text {
  font-size: 28rpx;
  color: var(--color-danger);
}
