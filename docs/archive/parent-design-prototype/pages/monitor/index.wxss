.page {
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
}

/* Video Section (Dark) */
.video-section {
  flex: 1;
  background-color: #1A1A2E;
  position: relative;
  min-height: 0;
}

.video-section image {
  filter: brightness(0) invert(1);
}

.robot-status-bar {
  position: absolute;
  top: 100rpx;
  left: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background-color: rgba(0,0,0,0.4);
  z-index: 2;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--color-accent-green);
}

.status-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.battery-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.top-actions {
  position: absolute;
  top: 100rpx;
  right: 24rpx;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  z-index: 2;
}

.circle-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.video-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.video-play-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.2;
}

.video-placeholder-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
}

/* Control Panel (Light Bottom) */
.control-panel {
  background-color: var(--color-background);
  padding: 32rpx 32rpx 24rpx 32rpx;
  padding-bottom: calc(24rpx + 120rpx);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.control-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.action-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-circle {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(49,106,253,0.25);
}

.action-circle.primary {
  background-color: var(--color-primary);
}

.action-circle.secondary {
  background-color: var(--color-secondary);
}

.action-circle:active {
  transform: scale(0.94);
}

.circle-icon {
  width: 44rpx;
  height: 44rpx;
}

.action-circle image {
  filter: brightness(0) invert(1);
}

.action-stack-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Joystick */
.joystick-control {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.joystick-bg {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background-color: #F3F4F6;
  border: 2rpx solid var(--color-divider);
}

.joystick-thumb {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(49,106,253,0.4);
  transition: left 0.06s ease-out, top 0.06s ease-out;
}

.joy-arrow {
  position: absolute;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.joy-arrow.top { top: 16rpx; left: 50%; transform: translateX(-50%); }
.joy-arrow.bottom { bottom: 16rpx; left: 50%; transform: translateX(-50%); }
.joy-arrow.left { left: 16rpx; top: 50%; transform: translateY(-50%); }
.joy-arrow.right { right: 16rpx; top: 50%; transform: translateY(-50%); }
.joy-arrow.active { color: var(--color-primary); font-weight: 700; }

/* Message Input */
.msg-input-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-card);
  border: 2rpx solid var(--color-divider);
}

.msg-input {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.msg-placeholder {
  font-size: 28rpx;
  color: var(--color-disabled);
}

.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn image {
  filter: brightness(0) invert(1);
}

.send-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ── Task Sheet Overlay ── */
.sheet-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  background-color: var(--color-overlay);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.sheet-panel {
  background-color: var(--color-card);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  min-height: 55vh;
}
.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx 0;
}
.handle-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-divider);
}
.sheet-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx 32rpx;
}
.sheet-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-90deg);
}
.close-icon {
  width: 48rpx;
  height: 48rpx;
}
.sheet-tabs {
  display: flex;
  flex-direction: row;
  padding: 0 32rpx;
}
.sheet-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}
.sheet-tab-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.sheet-tab-text.active {
  font-weight: 600;
  color: var(--color-primary);
}
.sheet-tab-bar {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
}
.sheet-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}
.sheet-task {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  border: 2rpx solid var(--color-card);
}
.sheet-task.checked {
  background-color: var(--color-tag-blue-bg);
  border-color: var(--color-primary);
}
.sheet-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--color-disabled);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.sheet-check.checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
.sheet-check-mark {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}
.sheet-task-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.sheet-task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.sheet-task-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.sheet-footer {
  padding: 32rpx;
  padding-bottom: calc(32rpx + 100rpx);
}
.sheet-send-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(49,106,253,0.2);
}
.sheet-send-icon {
  width: 36rpx;
  height: 36rpx;
}
.sheet-send-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.sheet-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 40rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.15);
  z-index: 2000;
}
.sheet-toast-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.sheet-toast-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--color-success);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-toast-check {
  width: 28rpx;
  height: 28rpx;
}
.sheet-toast-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.sheet-toast-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.sheet-toast-bar {
  width: 396rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-success);
}
