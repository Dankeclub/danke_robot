.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 16rpx 32rpx 0 32rpx;
}

/* Growth Card */
.growth-card {
  background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.growth-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.growth-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(255,255,255,0.13);
  display: flex;
  align-items: center;
  justify-content: center;
}

.growth-emoji {
  font-size: 40rpx;
}

.growth-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.growth-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* Daily Goal Card */
.daily-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 28rpx 32rpx 32rpx 32rpx;
  margin-bottom: 16rpx;
}

.daily-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.daily-icon {
  width: 36rpx;
  height: 36rpx;
}

.daily-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* Stepper */
.stepper-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stepper-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn.minus {
  background-color: var(--color-tag-blue-bg);
}

.stepper-btn.plus {
  background-color: var(--color-primary);
}

.stepper-btn:active {
  transform: scale(0.93);
}

.stepper-symbol {
  font-size: 40rpx;
}

.stepper-symbol.minus {
  color: var(--color-primary);
}

.stepper-symbol.plus {
  color: #FFFFFF;
}

.stepper-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stepper-time {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
}

.stepper-value {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
}

.stepper-unit {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.stepper-hint {
  font-size: 22rpx;
  color: var(--color-light-blue);
}

/* Progress Slider */
.progress-wrap {
  position: relative;
  height: 36rpx;
  display: flex;
  align-items: center;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-divider);
}

.progress-fill {
  position: absolute;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-primary);
}

.progress-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 5rpx solid var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(49,106,253,0.2);
}

/* Subject Goals Card */
.subj-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 8rpx 0;
  margin-bottom: 16rpx;
}

.subj-header {
  padding: 28rpx 32rpx 8rpx 32rpx;
}

.subj-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.subj-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.subj-row:last-child {
  border-bottom: none;
}

.subj-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.subj-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.subj-icon {
  width: 32rpx;
  height: 32rpx;
}

.subj-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  width: 120rpx;
}

.subj-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.subj-min {
  font-size: 26rpx;
  font-weight: 600;
  width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}

.subj-slider {
  flex: 1;
  height: 36rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.subj-track {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-divider);
}

.subj-fill {
  position: absolute;
  height: 8rpx;
  border-radius: 4rpx;
}

.subj-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 4rpx solid;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* Weekly Goal Card */
.week-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.week-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.week-icon {
  width: 36rpx;
  height: 36rpx;
}

.week-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.week-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.week-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.week-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* AI Recommend Card */
.ai-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ai-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ai-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--color-primary), var(--color-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.ai-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.ai-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* Save Button */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(49,106,253,0.2);
  margin-bottom: 16rpx;
}

.save-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
