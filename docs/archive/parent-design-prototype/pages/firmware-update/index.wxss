.page{min-height:100vh;background-color:var(--color-background);display:flex;flex-direction:column;width:100%;overflow-x:hidden}

.content{flex:1;padding:32rpx 32rpx 0 32rpx}

/* Version Card */
.version-card{
  background-color:var(--color-card);
  border-radius:var(--radius-md);
  padding:40rpx 32rpx;
  box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04);
  display:flex;
  flex-direction:column;
  align-items:center;
  margin-bottom:24rpx;
}

.version-label{
  font-size:var(--font-size-sm);
  color:var(--color-text-secondary);
  margin-bottom:16rpx;
}

.version-number{
  font-size:var(--font-size-2xl);
  font-weight:700;
  color:var(--color-text-primary);
  margin-bottom:16rpx;
}

.latest-badge{
  padding:6rpx 20rpx;
  border-radius:var(--radius-pill);
  background-color:var(--color-tag-green-bg);
}

.latest-badge text{
  font-size:var(--font-size-xs);
  color:var(--color-success);
}

/* Changelog */
.changelog-section{
  margin-bottom:24rpx;
}

.changelog-header{
  margin-bottom:16rpx;
}

.changelog-version{
  font-size:var(--font-size-md);
  font-weight:600;
  color:var(--color-text-primary);
}

.changelog-card{
  background-color:var(--color-card);
  border-radius:var(--radius-md);
  padding:24rpx 32rpx;
  box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04);
}

.changelog-item{
  display:flex;
  flex-direction:row;
  align-items:flex-start;
  padding:12rpx 0;
}

.changelog-item:not(:last-child){
  border-bottom:1rpx solid var(--color-divider);
}

.bullet{
  width:8rpx;
  height:8rpx;
  border-radius:50%;
  background-color:var(--color-primary);
  margin-top:12rpx;
  margin-right:16rpx;
  flex-shrink:0;
}

.log-text{
  font-size:var(--font-size-sm);
  color:var(--color-text-secondary);
  line-height:1.6;
  flex:1;
}

/* Check Update Button */
.check-btn{
  width:100%;
  height:96rpx;
  background-color:var(--color-primary);
  border-radius:var(--radius-md);
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 8rpx 32rpx rgba(49,106,253,0.2);
  margin-bottom:32rpx;
}

.check-btn text{
  font-size:var(--font-size-base);
  color:var(--color-text-white);
  font-weight:500;
}
