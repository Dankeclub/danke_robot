.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

/* Header */
.header {
  padding-bottom: 0;
}

.header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.share-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-tag-blue-bg);
}

.share-icon {
  width: 28rpx;
  height: 28rpx;
}

.share-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* Tab Switch */
.tab-switch {
  display: flex;
  flex-direction: row;
  padding: 0 32rpx 32rpx 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
  border-bottom: 2rpx solid var(--color-divider);
}

.tab-item.active {
  border-bottom-color: var(--color-primary);
}

.tab-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-label.active {
  font-weight: 600;
  color: var(--color-primary);
}

/* Content */
.content {
  flex: 1;
  padding: 0 32rpx 0 32rpx;
}

/* AI Card */
.ai-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.ai-card image {
  filter: brightness(0) invert(1);
}

.ai-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ai-sparkle {
  width: 36rpx;
  height: 36rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.ai-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.87);
  line-height: 1.6;
}

/* Score Section */
.score-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.score-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx;
}

.score-card {
  flex: 1;
  min-width: 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-card);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.score-val {
  font-size: 48rpx;
  font-weight: 700;
}

.score-lbl {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* History Section */
.history-section {
  margin-bottom: 32rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-card);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.hist-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hist-date-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.hist-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-tag-blue-bg);
  font-size: 20rpx;
  color: var(--color-primary);
}

.hist-date {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.hist-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.hist-arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.3;
}
