<view class="page">
  <nav-bar title="编辑资料" />

  <scroll-view scroll-y class="content" show-scrollbar="{{false}}">
    <!-- Avatar -->
    <view class="avatar-area" bindtap="onAvatarTap">
      <view class="avatar-circle">
        <image src="/assets/icons/user-white.svg" class="avatar-img" />
      </view>
      <view class="camera-badge">
        <image src="/assets/icons/camera.svg" class="camera-icon" />
      </view>
    </view>

    <!-- Form Card -->
    <view class="form-card">
      <view class="field-row">
        <view class="field-left">
          <image src="/assets/icons/user.svg" class="field-icon" />
          <text class="field-label">昵称</text>
        </view>
        <input class="field-input" value="{{formData.nickname}}" bindinput="onInput" data-field="nickname" />
      </view>
      <view class="field-divider"></view>

      <view class="field-row">
        <view class="field-left">
          <image src="/assets/icons/smartphone.svg" class="field-icon" />
          <text class="field-label">手机号</text>
        </view>
        <input class="field-input" value="{{formData.phone}}" bindinput="onInput" data-field="phone" />
      </view>
      <view class="field-divider"></view>

      <view class="field-row">
        <view class="field-left">
          <image src="/assets/icons/info-blue.svg" class="field-icon" />
          <text class="field-label">孩子昵称</text>
        </view>
        <input class="field-input" value="{{formData.childName}}" bindinput="onInput" data-field="childName" />
      </view>
      <view class="field-divider"></view>

      <picker mode="selector" range="{{ages}}" bindchange="onAgeChange">
        <view class="field-row">
          <view class="field-left">
            <image src="/assets/icons/clock.svg" class="field-icon" />
            <text class="field-label">孩子年龄</text>
          </view>
          <view class="picker-value">
            <text class="field-value">{{formData.childAge}}</text>
            <image src="/assets/icons/chevron-right.svg" class="arrow-icon" />
          </view>
        </view>
      </picker>
      <view class="field-divider"></view>

      <picker mode="selector" range="{{grades}}" bindchange="onGradeChange">
        <view class="field-row">
          <view class="field-left">
            <image src="/assets/icons/book.svg" class="field-icon" />
            <text class="field-label">孩子年级</text>
          </view>
          <view class="picker-value">
            <text class="field-value">{{formData.childGrade}}</text>
            <image src="/assets/icons/chevron-right.svg" class="arrow-icon" />
          </view>
        </view>
      </picker>
    </view>

    <!-- Save Button -->
    <view class="save-btn" bindtap="onSave">
      <text class="save-text">保存修改</text>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
