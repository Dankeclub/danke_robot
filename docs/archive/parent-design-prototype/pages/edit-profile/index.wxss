.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 32rpx 32rpx 0 32rpx;
  display: flex;
  flex-direction: column;
}

/* Avatar Area */
.avatar-area {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 32rpx;
}

.avatar-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
}

.camera-badge {
  position: absolute;
  bottom: 0;
  right: 50%;
  transform: translateX(28rpx);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.camera-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Form Card */
.form-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 8rpx 0;
  margin-bottom: 32rpx;
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.field-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.field-icon {
  width: 36rpx;
  height: 36rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.field-input {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  min-width: 200rpx;
}

picker {
  display: block;
  width: 100%;
}

.picker-value {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.field-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.field-divider {
  height: 2rpx;
  background-color: var(--color-divider);
  margin: 0 32rpx;
}

/* Save Button */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(49, 106, 253, 0.2);
}

.save-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
