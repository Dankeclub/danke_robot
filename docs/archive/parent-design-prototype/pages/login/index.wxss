.page{min-height:100vh;background-color:var(--color-background);display:flex;flex-direction:column;width:100%;overflow-x:hidden}

/* Top Gradient Area */
.top-area{
  background:linear-gradient(180deg, var(--color-primary), var(--color-secondary));
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:120rpx 32rpx 80rpx 32rpx;
}

.logo-circle{
  width:160rpx;
  height:160rpx;
  border-radius:50%;
  background-color:rgba(255,255,255,0.2);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:40rpx;
}

.logo-icon{
  width:80rpx;
  height:80rpx;
}

.app-title{
  font-size:40rpx;
  font-weight:700;
  color:var(--color-text-white);
  margin-bottom:16rpx;
}

.app-subtitle{
  font-size:var(--font-size-base);
  color:rgba(255,255,255,0.8);
}

/* Bottom Card Area */
.bottom-card{
  background-color:var(--color-card);
  border-radius:48rpx 48rpx 0 0;
  padding:48rpx 32rpx 64rpx 32rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
}

.login-title{
  font-size:var(--font-size-lg);
  font-weight:600;
  color:var(--color-text-primary);
  margin-bottom:12rpx;
}

.login-desc{
  font-size:var(--font-size-sm);
  color:var(--color-text-secondary);
  margin-bottom:48rpx;
}

.wechat-btn{
  width:100%;
  height:96rpx;
  background-color:var(--color-success);
  border-radius:var(--radius-md);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:32rpx;
}

.wechat-btn text{
  font-size:var(--font-size-base);
  color:var(--color-text-white);
  font-weight:600;
}

.terms-text{
  font-size:var(--font-size-xs);
  color:var(--color-text-secondary);
  text-align:center;
}
