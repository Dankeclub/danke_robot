<view class="page">
  <nav-bar title="帮助中心" />

  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <text class="section-title">常见问题</text>

    <view class="faq-card">
      <view class="faq-row" wx:for="{{faqList}}" wx:key="id">
        <view class="faq-q">{{item.question}}</view>
        <view class="faq-a">{{item.answer}}</view>
        <view class="faq-divider" wx:if="{{index < faqList.length - 1}}"></view>
      </view>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
