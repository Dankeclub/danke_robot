.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

/* Profile Card */
.profile-card {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  padding: 48rpx 40rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.profile-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  width: 56rpx;
  height: 56rpx;
}

.profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.parent-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.welcome-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.edit-profile-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  align-self: flex-start;
  gap: 12rpx;
  padding: 12rpx 28rpx;
  border-radius: 200rpx;
  background-color: rgba(255, 255, 255, 0.13);
}

.edit-icon {
  width: 28rpx;
  height: 28rpx;
}

.edit-label {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* Content */
.content {
  flex: 1;
  padding: 24rpx 32rpx 16rpx 32rpx;
  display: flex;
  flex-direction: column;
}

/* Child Info Card */
.child-info-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
}

.child-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.child-emoji {
  font-size: 44rpx;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.child-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 200rpx;
  background-color: var(--color-tag-green-bg);
}

.status-text {
  font-size: 20rpx;
  color: var(--color-success);
}

.child-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}

/* Device Card */
.device-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.device-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.device-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-icon {
  width: 36rpx;
  height: 36rpx;
}

.device-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.device-status {
  font-size: 22rpx;
}

.device-status.online {
  color: var(--color-success);
}

.device-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 36rpx;
  height: 36rpx;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.stat-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* Function List Card */
.func-list-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 4rpx 0;
  margin-bottom: 20rpx;
}

.func-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.func-item:last-child {
  border-bottom: none;
}

.func-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.func-icon {
  width: 28rpx;
  height: 28rpx;
}

.func-text {
  flex: 1;
}

.func-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.func-arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
}

/* Logout */
.logout-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.logout-text {
  font-size: 28rpx;
  color: var(--color-danger);
}

/* Dialog */
.dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-box {
  width: 600rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.dialog-message {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-top: 16rpx;
  line-height: 1.5;
}

.dialog-buttons {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-top: 40rpx;
  width: 100%;
}

.dialog-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 200rpx;
}

.dialog-btn.cancel {
  background-color: var(--color-tag-blue-bg);
}

.dialog-btn.confirm {
  background-color: var(--color-danger);
}

.cancel-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.confirm-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
