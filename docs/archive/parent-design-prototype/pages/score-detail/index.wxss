.page{min-height:100vh;background-color:var(--color-background);display:flex;flex-direction:column;width:100%;overflow-x:hidden}
.content{flex:1;padding:32rpx 32rpx 0 32rpx}
.card{background-color:var(--color-card);border-radius:var(--radius-lg);padding:32rpx;margin-bottom:24rpx;box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04)}

/* Score header card */
.score-header-card{display:flex;flex-direction:column;align-items:center;padding:40rpx 32rpx}
.header-label{font-size:var(--font-size-base);color:var(--color-text-secondary);margin-bottom:12rpx}
.header-score{font-size:80rpx;font-weight:700;color:var(--color-primary);line-height:1.2;margin-bottom:12rpx}
.header-change{font-size:var(--font-size-base);color:var(--color-success);font-weight:500}

/* Comparison card */
.comparison-title{font-size:var(--font-size-md);font-weight:600;color:var(--color-text-primary);margin-bottom:20rpx}
.detail-row{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:20rpx 0}
.detail-label{font-size:var(--font-size-base);color:var(--color-text-secondary)}
.detail-right{display:flex;flex-direction:row;align-items:center;gap:16rpx}
.detail-value{font-size:var(--font-size-base);color:var(--color-text-primary);font-weight:500}
.detail-change{font-size:var(--font-size-sm);font-weight:600}
.detail-change.positive{color:var(--color-success)}
.detail-divider{height:1rpx;background-color:var(--color-divider)}

/* AI suggestion box */
.ai-box{background-color:var(--color-tag-blue-bg);border-radius:var(--radius-lg);padding:32rpx;margin-bottom:24rpx}
.ai-header{display:flex;flex-direction:row;align-items:center;margin-bottom:16rpx}
.ai-icon{width:40rpx;height:40rpx;margin-right:12rpx}
.ai-title{font-size:var(--font-size-md);font-weight:600;color:var(--color-primary)}
.ai-text{font-size:var(--font-size-base);color:var(--color-text-secondary);line-height:1.8}
