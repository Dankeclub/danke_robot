.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 8rpx 32rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* App Icon */
.app-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(49,106,253,0.25);
  margin-top: 32rpx;
}

.app-icon-img {
  width: 88rpx;
  height: 88rpx;
  filter: brightness(0) invert(1);
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 24rpx;
}

.app-version {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  margin-bottom: 48rpx;
}

/* Info Card */
.info-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  padding: 8rpx 0;
  width: 100%;
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.row-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.row-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.row-arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.3;
}

.row-divider {
  height: 2rpx;
  background-color: var(--color-divider);
  margin: 0 32rpx;
}
