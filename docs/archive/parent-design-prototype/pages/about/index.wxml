<view class="page">
  <nav-bar title="关于我们" />

  <scroll-view scroll-y class="content" show-scrollbar="{{false}}">
    <!-- App Icon -->
    <view class="app-icon-wrap">
      <image src="/assets/icons/bot.svg" class="app-icon-img" />
    </view>

    <text class="app-name">AI陪伴机器人</text>
    <text class="app-version">版本 1.2.0</text>

    <!-- Info List -->
    <view class="info-card">
      <view class="info-row" wx:for="{{infoItems}}" wx:key="key" bindtap="onRowTap" data-key="{{item.key}}">
        <image src="/assets/icons/{{item.icon}}.svg" class="row-icon" />
        <text class="row-label">{{item.label}}</text>
        <image src="/assets/icons/chevron-right.svg" class="row-arrow" />
      </view>
      <view class="row-divider" wx:if="{{index < infoItems.length - 1}}"></view>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
