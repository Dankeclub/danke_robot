.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 8rpx 32rpx 0 32rpx;
  display: flex;
  flex-direction: column;
}

/* Metrics Row */
.metrics-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  flex: 1;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.metric-ring {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 10rpx solid var(--color-divider);
  box-sizing: border-box;
}

.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 10rpx solid transparent;
  box-sizing: border-box;
}

.ring-fill.focus {
  border-color: var(--color-primary) transparent transparent transparent;
  transform: rotate(-45deg);
}

.ring-fill.posture {
  border-color: var(--color-warning) transparent transparent transparent;
  transform: rotate(-45deg);
}

.ring-center {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 4rpx;
}

.ring-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.ring-unit {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.metric-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.metric-desc {
  font-size: 22rpx;
}

.metric-desc.success {
  color: var(--color-success);
}

.metric-desc.warning {
  color: var(--color-warning);
}

/* Activity Card */
.activity-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.activity-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.activity-period {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.activity-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.bar-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  width: 112rpx;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: var(--color-divider);
}

.bar-fill {
  height: 16rpx;
  border-radius: 8rpx;
}

.bar-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}

/* AI Card */
.ai-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.ai-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ai-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-icon {
  width: 28rpx;
  height: 28rpx;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.suggestion-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  background-color: var(--color-background);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
}

.sug-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.sug-text {
  font-size: 24rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  flex: 1;
}
