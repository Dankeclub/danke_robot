.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

/* Period Tabs */
.period-tabs {
  display: flex;
  flex-direction: row;
  background-color: var(--color-background);
  padding: 0 32rpx 24rpx 32rpx;
}

.period-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.period-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.period-text.active {
  font-weight: 600;
  color: var(--color-primary);
}

.period-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
}

/* Content */
.content {
  flex: 1;
  padding: 0 32rpx 0 32rpx;
}

.card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.card-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* Today Overview */
.today-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.today-left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.today-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.time-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.time-big {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
}

.time-unit {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.today-compare {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.today-ring {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
}

.ring-sm-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 12rpx solid var(--color-divider);
  box-sizing: border-box;
}

.ring-sm-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 12rpx solid transparent;
  border-top-color: var(--color-primary);
  border-right-color: var(--color-primary);
  transform: rotate(-25deg);
  box-sizing: border-box;
}

.ring-sm-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-sm-pct {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.today-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.t-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.t-stat-icon {
  width: 36rpx;
  height: 36rpx;
}

.t-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.t-stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Week Avg */
.week-avg {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.avg-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.avg-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* Chart */
.chart-bars {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  height: 240rpx;
}

.chart-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.chart-bar {
  width: 56rpx;
  border-radius: 12rpx 12rpx 0 0;
}

.chart-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.chart-label.active {
  font-weight: 600;
  color: var(--color-primary);
}

/* Usage Details */
.detail-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-dot {
  width: 8rpx;
  height: 64rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.detail-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.detail-time {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.detail-dur {
  font-size: 26rpx;
  font-weight: 600;
}
