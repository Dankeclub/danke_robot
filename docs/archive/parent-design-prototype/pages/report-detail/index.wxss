.page{min-height:100vh;background-color:var(--color-background);display:flex;flex-direction:column;width:100%;overflow-x:hidden}
.content{flex:1;padding:0 32rpx 0 32rpx}
.date-bar{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:8rpx 0 16rpx 0}
.date-text{font-size:24rpx;color:var(--color-text-secondary)}
.week-badge{padding:6rpx 20rpx;border-radius:var(--radius-pill);background-color:var(--color-tag-green-bg)}
.week-badge-text{font-size:20rpx;color:var(--color-success)}
.card{background-color:var(--color-card);border-radius:var(--radius-lg);box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04);padding:32rpx;margin-bottom:8rpx}
.card-title{font-size:30rpx;font-weight:600;color:var(--color-text-primary);margin-bottom:24rpx;display:block}
.card-header-row{display:flex;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:24rpx}
.score-row{display:flex;flex-direction:row;align-items:center;gap:28rpx}
.score-ring{position:relative;width:160rpx;height:160rpx;flex-shrink:0}
.ring-bg{position:absolute;inset:0;border-radius:50%;border:10rpx solid var(--color-divider);box-sizing:border-box}
.ring-fill{position:absolute;inset:0;border-radius:50%;border:10rpx solid transparent;border-top-color:var(--color-primary);border-right-color:var(--color-primary);transform:rotate(-30deg);box-sizing:border-box}
.ring-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.ring-grade{font-size:52rpx;font-weight:700;color:var(--color-primary)}
.score-right{flex:1;display:flex;flex-direction:column;gap:20rpx}
.score-title{font-size:32rpx;font-weight:600;color:var(--color-text-primary)}
.score-desc{font-size:24rpx;color:var(--color-text-secondary);line-height:1.5}
.mini-stats{display:flex;flex-direction:row;justify-content:space-between}
.ms-item{display:flex;flex-direction:column;align-items:center;gap:4rpx}
.ms-value{font-size:28rpx;font-weight:600;color:var(--color-text-primary)}
.ms-label{font-size:20rpx;color:var(--color-text-secondary)}
.ai-header{display:flex;flex-direction:row;align-items:center;gap:16rpx;margin-bottom:20rpx}
.ai-badge{width:48rpx;height:48rpx;border-radius:24rpx;background:linear-gradient(180deg,var(--color-primary),var(--color-secondary));display:flex;align-items:center;justify-content:center}
.ai-badge-icon{width:24rpx;height:24rpx}
.ai-title{font-size:28rpx;font-weight:600;color:var(--color-text-primary)}
.ai-comment{font-size:26rpx;color:var(--color-text-primary);line-height:1.6;margin-bottom:16rpx}
.ai-teacher{font-size:22rpx;color:var(--color-light-blue)}
.subj-row{display:flex;flex-direction:row;align-items:center;gap:20rpx;margin-bottom:20rpx}
.subj-row:last-child{margin-bottom:0}
.subj-name{font-size:26rpx;color:var(--color-text-primary);width:128rpx;flex-shrink:0}
.subj-bar-track{flex:1;height:16rpx;border-radius:8rpx;background-color:var(--color-divider)}
.subj-bar-fill{height:16rpx;border-radius:8rpx}
.subj-score{font-size:26rpx;font-weight:600;width:80rpx;text-align:right;flex-shrink:0}
.trend-badge{display:flex;align-items:center}
.trend-badge-text{font-size:22rpx;color:var(--color-success)}
.chart-bars{display:flex;flex-direction:row;align-items:flex-end;justify-content:space-around;height:160rpx}
.chart-day{display:flex;flex-direction:column;align-items:center;gap:8rpx}
.chart-bar{width:48rpx;border-radius:12rpx 12rpx 0 0}
.chart-label{font-size:20rpx;color:var(--color-text-secondary)}
.legend-row{display:flex;flex-direction:row;justify-content:center;gap:40rpx;margin-top:20rpx}
.legend-item{display:flex;flex-direction:row;align-items:center;gap:12rpx}
.legend-dot{width:20rpx;height:20rpx;border-radius:50%}
.legend-dot.primary{background-color:var(--color-primary)}
.legend-dot.disabled{background-color:var(--color-disabled)}
.legend-text{font-size:22rpx;color:var(--color-text-secondary)}
.legend-text.disabled{color:var(--color-disabled)}
.hl-item{display:flex;flex-direction:row;align-items:flex-start;gap:16rpx;margin-bottom:16rpx}
.hl-item:last-child{margin-bottom:0}
.hl-icon{width:28rpx;height:28rpx;flex-shrink:0;margin-top:4rpx}
.hl-text{font-size:26rpx;color:var(--color-text-primary);line-height:1.5;flex:1}
