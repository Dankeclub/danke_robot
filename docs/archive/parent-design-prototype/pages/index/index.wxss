.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

/* Header */
.header {
  padding-bottom: 0;
}

.header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.greeting-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.greeting-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.header-right {
  display: flex;
  align-items: center;
}

.icon-48 {
  width: 48rpx;
  height: 48rpx;
}

/* Content */
.content {
  flex: 1;
  padding: 0 32rpx 32rpx 32rpx;
}

/* Child Card */
.child-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.child-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 200rpx;
  background-color: var(--color-light-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  width: 56rpx;
  height: 56rpx;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.child-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.online-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 200rpx;
  background-color: var(--color-tag-green-bg);
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--color-success);
}

.online-text {
  font-size: 20rpx;
  color: #4CAF50;
}

.child-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* Stats Card */
.stats-card {
  display: flex;
  flex-direction: row;
  padding: 32rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-top: 32rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* Section */
.section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* Quick Access */
.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.quick-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 176rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.quick-icon-bg {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.quick-label {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

/* Task List */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-md);
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.task-text {
  flex: 1;
}

.task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.task-name.done {
  color: var(--color-text-secondary);
  font-weight: normal;
}

.doing-tag {
  padding: 4rpx 16rpx;
  border-radius: 200rpx;
  background-color: var(--color-tag-blue-bg);
}

.doing-text {
  font-size: 20rpx;
  color: var(--color-primary);
}

/* Behavior */
.behavior-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.behavior-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
}

.behavior-item.border-top {
  border-top: 2rpx solid var(--color-divider);
}

.bh-time {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  width: 72rpx;
}

.bh-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.bh-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

/* ── Task Sheet Overlay ── */
.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background-color: var(--color-overlay);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-panel {
  background-color: var(--color-card);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  min-height: 55vh;
}

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx 0;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-divider);
}

.sheet-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx 32rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-90deg);
}

.close-icon {
  width: 48rpx;
  height: 48rpx;
}

.sheet-tabs {
  display: flex;
  flex-direction: row;
  padding: 0 32rpx 0 32rpx;
}

.sheet-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.sheet-tab-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.sheet-tab-text.active {
  font-weight: 600;
  color: var(--color-primary);
}

.sheet-tab-bar {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
}

.sheet-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.sheet-task {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  border: 2rpx solid var(--color-card);
}

.sheet-task.checked {
  background-color: var(--color-tag-blue-bg);
  border-color: var(--color-primary);
}

.sheet-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--color-disabled);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-check.checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.sheet-check-mark {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.sheet-task-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet-task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.sheet-task-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.sheet-footer {
  padding: 32rpx;
  padding-bottom: calc(32rpx + 100rpx);
}

.sheet-send-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(49,106,253,0.2);
}

.sheet-send-icon {
  width: 36rpx;
  height: 36rpx;
}

.sheet-send-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Sheet Toast */
.sheet-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 40rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.15);
  z-index: 2000;
}

.sheet-toast-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.sheet-toast-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--color-success);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-toast-check {
  width: 28rpx;
  height: 28rpx;
}

.sheet-toast-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-toast-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.sheet-toast-bar {
  width: 396rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-success);
}
