.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 0 32rpx 0 32rpx;
}

/* Cards */
.card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.card-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.card-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.period-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-tag-blue-bg);
}

.period-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* Overview */
.overview-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 40rpx;
}

.overview-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.ring-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 14rpx solid var(--color-divider);
  box-sizing: border-box;
}

.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 14rpx solid transparent;
  border-top-color: var(--color-primary);
  border-right-color: var(--color-primary);
  transform: rotate(-20deg);
  box-sizing: border-box;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.ring-score {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.ring-unit {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.overview-stats {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.o-stat {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.o-stat-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.o-stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* Trend Chart */
.chart-bars {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  height: 180rpx;
}

.chart-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.chart-bar {
  width: 48rpx;
  border-radius: 12rpx 12rpx 0 0;
}

.chart-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Subjects */
.subject-item {
  margin-bottom: 24rpx;
}

.subject-item:last-child {
  margin-bottom: 0;
}

.subject-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.subject-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.subject-pct {
  font-size: 24rpx;
  font-weight: 600;
}

.subject-bar-track {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: var(--color-divider);
}

.subject-bar-fill {
  height: 12rpx;
  border-radius: 6rpx;
}

/* Records */
.records-section {
  margin-top: 4rpx;
}

.record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 28rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 16rpx;
}

.record-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background-color: var(--color-tag-blue-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-icon {
  width: 40rpx;
  height: 40rpx;
}

.record-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.record-time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-tag-green-bg);
}

.score-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-success);
}
