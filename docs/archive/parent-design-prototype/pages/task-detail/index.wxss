.page{min-height:100vh;background-color:var(--color-background);display:flex;flex-direction:column;width:100%;overflow-x:hidden}
.content{flex:1;padding:32rpx 32rpx 0 32rpx}
.card{background-color:var(--color-card);border-radius:var(--radius-lg);padding:32rpx;margin-bottom:24rpx;box-shadow:0 4rpx 24rpx rgba(0,0,0,0.04)}

/* Header card */
.status-badge{display:inline-block;background-color:var(--color-tag-blue-bg);color:var(--color-primary);font-size:var(--font-size-sm);padding:8rpx 24rpx;border-radius:var(--radius-pill);margin-bottom:20rpx}
.header-title{font-size:var(--font-size-xl);font-weight:600;color:var(--color-text-primary);margin-bottom:12rpx}
.header-desc{font-size:var(--font-size-base);color:var(--color-text-secondary)}

/* Score card */
.stat-row{display:flex;flex-direction:row;align-items:center;justify-content:space-around}
.stat-item{display:flex;flex-direction:column;align-items:center}
.stat-value{font-size:var(--font-size-2xl);font-weight:700;color:var(--color-primary)}
.stat-label{font-size:var(--font-size-sm);color:var(--color-text-secondary);margin-top:8rpx}

/* Detail card */
.detail-row{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:20rpx 0}
.detail-label{font-size:var(--font-size-base);color:var(--color-text-secondary)}
.detail-value{font-size:var(--font-size-base);color:var(--color-text-primary);font-weight:500}
.detail-divider{height:1rpx;background-color:var(--color-divider)}
