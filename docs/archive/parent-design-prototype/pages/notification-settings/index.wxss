.page {
  min-height: 100vh;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
}

.content {
  flex: 1;
  padding: 16rpx 32rpx 0 32rpx;
  display: flex;
  flex-direction: column;
}

/* Description Card */
.desc-card {
  background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.desc-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.desc-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.13);
  display: flex;
  align-items: center;
  justify-content: center;
}

.desc-icon {
  width: 40rpx;
  height: 40rpx;
}

.desc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.desc-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* Section Cards */
.section-card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding: 4rpx 0;
  margin-bottom: 16rpx;
}

.section-header {
  padding: 24rpx 32rpx 16rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}

.switch-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.switch-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.switch-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.row-divider {
  height: 2rpx;
  background-color: var(--color-divider);
  margin: 0 32rpx;
}

/* Auth Footer */
.auth-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.auth-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.auth-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
}

.auth-btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* DND */
.dnd-main-label {
  font-weight: 600;
}

.dnd-time-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}

.dnd-time-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.dnd-moon-icon {
  width: 32rpx;
  height: 32rpx;
}

.dnd-time-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.dnd-time-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.dnd-time-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.dnd-time-value.disabled {
  color: var(--color-disabled);
}

.dnd-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

.dnd-arrow.disabled {
  opacity: 0.2;
}
