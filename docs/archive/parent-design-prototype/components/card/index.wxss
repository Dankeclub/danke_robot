.card {
  width: 100%;
  border-radius: var(--radius-lg);
  background-color: var(--color-card);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-arrow {
  width: 40rpx;
  height: 40rpx;
}

.card-body {
  width: 100%;
}
